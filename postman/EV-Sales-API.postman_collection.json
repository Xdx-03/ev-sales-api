    {
      "name": "04 Permission boundary",
      "description": "严格验证普通客户不能访问后台用户列表。当前隔离环境会在此处暴露已记录缺陷 API-AUTHZ-001，不允许把断言改弱来获得绿色结果。",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Customer is forbidden from system user list [API-AUTHZ-001]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 403\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Business code is 403\", function () {",
                  "  pm.expect(body.code).to.eql(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sys/user/list",
            "description": "预期 HTTP 403 且业务码 403。若返回 HTTP 200/业务码 500，则复现 API-AUTHZ-001。"
          },
          "response": []
        }
      ]
