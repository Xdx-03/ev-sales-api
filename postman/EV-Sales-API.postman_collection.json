              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Inventory summary contract is valid\", function () {",
                  "  pm.expect(body.data).to.be.an(\"object\");",
                  "  pm.expect(Number.isInteger(body.data.count)).to.eql(true);",
                  "  pm.expect(body.data.count).to.be.at.least(0);",
                  "  pm.expect(body.data.hasInventory).to.be.a(\"boolean\");",
                  "  pm.expect(body.data.hasInventory).to.eql(body.data.count > 0);",
                  "});"
                ]
