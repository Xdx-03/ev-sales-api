{
  "info": {
    "_postman_id": "0c3d5574-90f1-4d1e-9ef7-73961d10b2dc",
    "name": "EV Sales API - Safe Regression",
    "description": "新能源汽车销售系统的安全查询集合。仅包含登录、公开查询、客户本人查询和权限边界验证，不包含创建订单、支付、预约或售后写入接口。Apifox 可直接导入 Postman Collection v2.1。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.variables.replaceIn(\"{{baseUrl}}\").trim();",
          "const isHttps = /^https:\\/\\//i.test(baseUrl);",
          "const isLoopback = /^http:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?(\\/|$)/i.test(baseUrl);",
          "const containsCredentials = /^https?:\\/\\/[^/]*@/i.test(baseUrl);",
          "const isSafeTarget = (isHttps || isLoopback) && !containsCredentials;",
          "if (!isSafeTarget) {",
          "  pm.test(\"Base URL uses HTTPS or loopback without credentials\", function () {",
          "    pm.expect(isSafeTarget).to.eql(true);",
          "  });",
          "  pm.variables.set(\"baseUrl\", \"http://127.0.0.1:1\");",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "description": "登录接口由当前被测系统定义为 query 参数。非本机环境必须使用 HTTPS，并且只能使用可轮换的专用测试账号。",
      "item": [
        {
          "name": "Customer login and save token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Business code is 200\", function () {",
                  "  pm.expect(body.code).to.eql(200);",
                  "});",
                  "pm.test(\"Login returns a token\", function () {",
                  "  pm.expect(body.data).to.be.an(\"object\");",
                  "  pm.expect(body.data.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "if (body.code === 200 && body.data && body.data.token) {",
                  "  pm.collectionVariables.set(\"accessToken\", body.data.token);",
                  "  if (pm.environment.name) {",
                  "    pm.environment.set(\"accessToken\", body.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login?username={{customerUsername}}&password={{customerPassword}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "{{customerUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{customerPassword}}"
                }
              ]
            },
            "description": "使用专用客户测试账号登录，并把 JWT 保存到 accessToken。模板不包含真实账号或密码。"
          },
          "response": []
        },
        {
          "name": "Invalid credentials are rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Business code is 401\", function () {",
                  "  pm.expect(body.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login?username=not_exists_user_for_api_test&password=wrong_password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "not_exists_user_for_api_test"
                },
                {
                  "key": "password",
                  "value": "wrong_password"
                }
              ]
            },
            "description": "使用明确的虚构无效凭据验证登录失败契约。"
          },
          "response": []
        }
      ]
    },
